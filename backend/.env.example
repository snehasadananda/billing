# ---- Server ----
NODE_ENV=production
PORT=5000
APP_TIMEZONE=Asia/Kolkata
# Comma separated list of allowed browser origins (your frontend URL)
CORS_ORIGINS=https://billing.yourdomain.com
# Set true to let Express also serve ../frontend/dist (single-process hosting)
SERVE_FRONTEND=false
# Set to 1 when behind a proxy / cPanel so rate limiting sees real IPs
TRUST_PROXY=1

# ---- Database (on cPanel use 127.0.0.1 and the cPanel-prefixed user + database name) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cpaneluser_billing
DB_PASSWORD=change_me
DB_NAME=cpaneluser_billing

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# ---- First admin (used by npm run seed) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123

# ---- Email (optional: leave SMTP_HOST blank to disable email sending) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Billing <no-reply@yourdomain.com>"

# ---- Scheduler / backups ----
ENABLE_SCHEDULER=true
BACKUP_DIR=./backups
